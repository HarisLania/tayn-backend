# ---------------------------------------------------------------------------
# Tayn Meal Plans - environment configuration
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# ---------------------------------------------------------------------------

# Core Django
# DEBUG=True  -> development/testing, uses SQLite
# DEBUG=False -> production, uses PostgreSQL (all POSTGRES_* vars required)
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (only used when DEBUG=False)
POSTGRES_DB=tayn
POSTGRES_USER=tayn
POSTGRES_PASSWORD=tayn
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Stripe - optional. Leave blank to run the backend without live payments.
# When blank, checkout/webhook endpoints return HTTP 503 instead of calling Stripe.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Currency used when `manage.py sync_stripe_prices` creates the Stripe prices.
STRIPE_CURRENCY=aed

# URLs Stripe redirects back to after a Checkout Session
CHECKOUT_SUCCESS_URL=http://localhost:4200/subscription?status=success
CHECKOUT_CANCEL_URL=http://localhost:4200/create-plan?status=cancelled

# CORS (comma separated); used by the SPA frontend
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
